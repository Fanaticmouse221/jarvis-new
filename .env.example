# =====================================================================
#  JARVIS configuration
#  setup.bat copies this file to .env. Edit .env, not this file.
#  .env holds your API keys and is ignored by git. Never commit it.
# =====================================================================

# ---------------------------------------------------------------------
#  API keys (all free tiers; no payment method needed)
# ---------------------------------------------------------------------
# Groq: the primary brain. Free tier, no card. Doesn't train on your data.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini: optional fallback. Key from https://aistudio.google.com/apikey
# Free-tier prompts may be used to improve Google's products and read by
# human reviewers, so don't send personal or sensitive information through it.
GEMINI_API_KEY=

# OpenRouter: optional fallback. Free models (IDs ending in :free) are
# capped at 50 requests/day on accounts that have never bought credits.
OPENROUTER_API_KEY=

# ---------------------------------------------------------------------
#  Models, in priority order (provider:model, comma-separated)
# ---------------------------------------------------------------------
# JARVIS uses the first model that works. If one fails or hits a rate
# limit before it starts replying, the next is tried automatically.
# Providers: groq, gemini, openrouter, ollama (local), custom, fake (offline)
# Run `uv run jarvis check` after changing this to confirm the models exist.
JARVIS_MODELS=groq:openai/gpt-oss-120b,groq:llama-3.1-8b-instant
#
# Entries you can add once you have the matching key:
#   gemini:gemini-3.8-flash
#   openrouter:openai/gpt-oss-120b:free
#   ollama:<a model name from `ollama list`>
# Try the interface with no key at all:
#   JARVIS_MODELS=fake:demo

# How hard gpt-oss models think before answering: low | medium | high.
# low = fastest replies. Leave blank to use the provider's default.
JARVIS_REASONING_EFFORT=low
JARVIS_MAX_OUTPUT_TOKENS=4096
# Leave blank for the model's default creativity.
JARVIS_TEMPERATURE=

# ---------------------------------------------------------------------
#  Personalisation
# ---------------------------------------------------------------------
JARVIS_USER_NAME=
JARVIS_USER_TITLE=sir

# ---------------------------------------------------------------------
#  Server
# ---------------------------------------------------------------------
# 127.0.0.1 means only this computer can connect. Keep it that way until
# JARVIS has a login (planned for Phase 7, remote access).
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_OPEN_BROWSER=true
JARVIS_DB_PATH=data/jarvis.db

# How much recent conversation is sent to the model on each turn.
# Lower these if you hit "request too large" or token-per-minute limits.
JARVIS_MAX_HISTORY_MESSAGES=30
JARVIS_MAX_CONTEXT_CHARS=12000

# ---------------------------------------------------------------------
#  Local and custom endpoints
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
# Any other OpenAI-compatible service (use provider "custom" in JARVIS_MODELS)
JARVIS_CUSTOM_BASE_URL=
JARVIS_CUSTOM_API_KEY=
