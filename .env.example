# =====================================================================
#  JARVIS configuration
#  setup.bat copies this file to .env. Edit .env, not this file.
#  .env holds your API keys and is ignored by git. Never commit it.
#
#  Most things are set inside the app (Settings): the Groq key, model
#  order, personality, permissions. This file is for the rest.
# =====================================================================

# ---------------------------------------------------------------------
#  API keys (the app writes these for you when you add a key in Settings)
# ---------------------------------------------------------------------
# Groq: free tier, no payment details. https://console.groq.com/keys
GROQ_API_KEY=
# Optional fallbacks:
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Telegram: create a bot with @BotFather, then connect it under Settings > Phone.
TELEGRAM_BOT_TOKEN=
# Optional local fake API for development. Leave unchanged for real Telegram.
JARVIS_TELEGRAM_API=https://api.telegram.org

# ---------------------------------------------------------------------
#  Model defaults (the app's Settings override these once you change them there)
# ---------------------------------------------------------------------
# provider:model, comma-separated, tried in order.
# Providers: groq, gemini, openrouter, ollama (local), custom, fake (scripted demo)
JARVIS_MODELS=groq:openai/gpt-oss-120b,groq:openai/gpt-oss-20b

# The most text one reply may contain. Groq's free tier counts the prompt plus
# this reservation against 8,000 tokens a minute, so keep it modest.
JARVIS_MAX_OUTPUT_TOKENS=2048
# Leave blank for the model's default creativity.
JARVIS_TEMPERATURE=

# How much recent conversation accompanies each message. Older parts are
# folded into a running summary, so nothing is simply forgotten.
JARVIS_MAX_HISTORY_MESSAGES=24
JARVIS_MAX_CONTEXT_CHARS=6000

# ---------------------------------------------------------------------
#  Window and server
# ---------------------------------------------------------------------
# app = its own window (via Microsoft Edge), browser = a browser tab, none = don't open anything
JARVIS_WINDOW=app
# 127.0.0.1 means only this computer can connect. Keep it that way: JARVIS
# can act on this computer, and there is no login for other devices yet.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DB_PATH=data/jarvis.db

# ---------------------------------------------------------------------
#  Local and custom endpoints
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
# Any other OpenAI-compatible service (use provider "custom" in the model list)
JARVIS_CUSTOM_BASE_URL=
JARVIS_CUSTOM_API_KEY=
